{
    "version": "2.0.0",
    "options": {
        "env": {
           "SSH_KEY": "/home/build-user/.ssh/id_rsa"
        },
    },
    "inputs": [
        {
            "type": "pickString",
            "id": "targetIp",
            "description": "target to deploy to?",
            "options": [
                "raspberrypi4-64-nomidi",
                "raspberrypi3-64-nomidi",
                "192.168.1.176"
            ],
            "default": "192.168.1.176"
        }
    ],
    "tasks": [
        {
            "label": "CMake-ARM-Debug",
            "type": "shell",
            "command": "${workspaceRoot}/Scripts/build_for_target.sh",
            "args": [
                "build/arm64-linux-gcc",
                "Debug"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
        },
        {
            "label": "CMake-ARM-Release",
            "type": "shell",
            "command": "${workspaceRoot}/Scripts/build_for_target.sh",
            "args": [
                "build/arm64-linux-gcc",
                "Release"
            ],
            "group": {
            "kind": "build",
            "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
        },
        {
            "label": "Deploy-ARM-Debug",
            "type": "shell",
            "command": "${workspaceRoot}/Scripts/deploy.sh",
            "args": [
                "build/arm64-linux-gcc",
                "Debug",
                "${input:targetIp}"
            ],
            "group": {
               "kind": "build",
               "isDefault": true
            },
            "problemMatcher": [ ],
            "dependsOn":["CMake-ARM-Debug"]
        },
        {
            "label": "Deploy-ARM-Release",
            "type": "shell",
            "command": "${workspaceRoot}/Scripts/deploy.sh",
            "args": [
                "build/arm64-linux-gcc",
                "Release",
                "${input:targetIp}"
            ],
            "group": {
               "kind": "build",
               "isDefault": true
            },
            "problemMatcher": [ ],
            "dependsOn":["CMake-ARM-Release"]
        },
        {
            "label": "Journalctl Target",
            "type": "shell",
            "command": "${workspaceRoot}/Scripts/journalctl.sh",
            "args": [
                "${input:targetIp}"
            ],
            "group": {
               "kind": "build",
               "isDefault": true
            },
            "problemMatcher": [ ]
        }
    ]
}