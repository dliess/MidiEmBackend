{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "options": {
        "env": {
            "buildType": "Release",
            "buildDirectory": "${workspaceRoot}/build"
        }
    },
    "tasks": [
        {
            "label": "Create build dir",
            "type": "shell",
            "command": "mkdir -p ${buildDirectory}",
            "problemMatcher": []
        },
        {
            "label": "Generate UNIX makefiles",
            "type": "shell",
            "command": "cd ${buildDirectory}; cmake ${workspaceRoot}",
            "problemMatcher": [],
            "dependsOn": [
                "Create build dir"
            ]
        },
        {
            "label": "Build release",
            "type": "shell",
            "command": "cd ${buildDirectory}; cmake --build . --parallel 8 --config {buildType}",
            "problemMatcher": [],
            "dependsOn": [
                "Generate UNIX makefiles"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}